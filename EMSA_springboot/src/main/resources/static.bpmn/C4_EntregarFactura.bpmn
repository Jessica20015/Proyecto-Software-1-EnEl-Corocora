      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E15_di" bpmnElement="Flow_E15">
        <di:waypoint x="1430" y="230" />
        <di:waypoint x="1502" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="TextAnnotation_Prueba_di" bpmnElement="TextAnnotation_Prueba">
        <dc:Bounds x="1300" y="420" width="300" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Association_Prueba_di" bpmnElement="Association_Prueba">
        <di:waypoint x="1400" y="420" />
        <di:waypoint x="1390" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="DataStoreReference_ExpedienteEntrega_di" bpmnElement="DataStoreReference_ExpedienteEntrega">
        <dc:Bounds x="1497" y="310" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1480" y="367" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="DataOutputAssociation_RegistrarPrueba_Expediente_di" bpmnElement="DataOutputAssociation_RegistrarPrueba_Expediente">
        <di:waypoint x="1430" y="260" />
        <di:waypoint x="1497" y="318" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
