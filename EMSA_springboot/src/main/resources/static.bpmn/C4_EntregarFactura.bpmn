        <di:waypoint x="718" y="230" />
        <di:waypoint x="1225" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E13_di" bpmnElement="Flow_E13">
        <di:waypoint x="1100" y="610" />
        <di:waypoint x="1250" y="610" />
        <di:waypoint x="1250" y="255" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_E14_di" bpmnElement="Flow_E14">
        <di:waypoint x="1275" y="230" />
