<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_C4_Facturar" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.39.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:collaboration id="Collaboration_C4">
    <bpmn:participant id="Participant_C4" name="ENEL La Corocora · Gerencia Comercial — C4 · Facturar el servicio de energía" processRef="C4_FacturarServicioEnergia">
      <bpmn:documentation>Proceso core seleccionado (I/S/F = 5/4/4). Dueño: Gerencia Comercial. Caso: un suministro en un período facturable.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_C3" name="C3 · Obtener y validar el consumo" />
    <bpmn:participant id="Participant_Usuario" name="Usuario / suscriptor" />
    <bpmn:participant id="Participant_C6" name="C6 · Investigar y normalizar una anomalía de medida" />
    <bpmn:participant id="Participant_C7" name="C7 · Atender una PQR del usuario" />
    <bpmn:participant id="Participant_G3" name="G3 · Actualizar el marco de riesgos y cumplimiento (marco tarifario)" />
    <bpmn:participant id="Participant_C5" name="C5 · Recaudar y gestionar una cuenta por cobrar" />
    <bpmn:messageFlow id="MessageFlow_ConsumoValidado" name="Consumo validado" sourceRef="Participant_C3" targetRef="StartEvent_ConsumoValidado" />
    <bpmn:messageFlow id="MessageFlow_RefacturacionC6" name="Refacturación autorizada" sourceRef="Participant_C6" targetRef="StartEvent_Refacturacion" />
    <bpmn:messageFlow id="MessageFlow_AjusteC7" name="Ajuste autorizado" sourceRef="Participant_C7" targetRef="StartEvent_Refacturacion" />
    <bpmn:messageFlow id="MessageFlow_ExcepcionC3" name="Excepción de consumo" sourceRef="Event_ExcepcionDevueltaC3" targetRef="Participant_C3" />
    <bpmn:messageFlow id="MessageFlow_ConsumoCorregido" name="Consumo corregido" sourceRef="Participant_C3" targetRef="Event_ConsumoCorregido" />
    <bpmn:messageFlow id="MessageFlow_SolicitudG3" name="Solicitud de regla tarifaria" sourceRef="Event_SolicitudReglaG3" targetRef="Participant_G3" />
    <bpmn:messageFlow id="MessageFlow_CuentaC5" name="Cuenta por cobrar" sourceRef="Event_CuentaPorCobrarC5" targetRef="Participant_C5" />
    <bpmn:messageFlow id="MessageFlow_FacturaUsuario" name="Factura" sourceRef="Activity_EntregarFactura" targetRef="Participant_Usuario" />
  </bpmn:collaboration>
  <bpmn:process id="C4_FacturarServicioEnergia" name="C4 · Facturar el servicio de energía" isExecutable="true" camunda:versionTag="1.0" camunda:historyTimeToLive="180">
    <bpmn:laneSet id="LaneSet_C4_FacturarServicioEnergia">
      <bpmn:lane id="Lane_SistemaComercial" name="Sistema comercial · motor de liquidación">
        <bpmn:flowNodeRef>StartEvent_ConsumoValidado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_Refacturacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinInicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ConsolidarInsumos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ReglaNoVigente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_SolicitudReglaG3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ClasificarConsumo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Tratamiento</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinDevolver</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ExcepcionDevueltaC3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EsperaC3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ConsumoCorregido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_PlazoC3Vencido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_AsignarConsumoPromedio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinFacturar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinTarifa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_DeterminarTarifa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_LiquidarFactura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_EmitirFactura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SplitEmision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_EntregarFactura</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RegistrarExpediente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_CuentaPorCobrarC5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinEmision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_FacturaEntregada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_AnalistaFacturacion" name="Analista de facturación">
        <bpmn:flowNodeRef>Activity_RevisarExcepcion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_DecisionAnalista</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ControlCalidad" name="Control de calidad de facturación">
        <bpmn:flowNodeRef>Activity_VerificarCalidad</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_SlaCalidadVencido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_EscalarCoordinador</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_VerificacionEscalada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Calidad</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LiquidadorTarifario" name="Liquidador tarifario">
        <bpmn:flowNodeRef>Activity_CorregirLiquidacion</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_ConsumoValidado" name="Consumo validado recibido">
      <bpmn:documentation>Disparador de C4: consumo validado disponible desde C3 (interfaz de entrada C3). Caso: un suministro en un período facturable. t0 = fechaLiberacionC3, inicio del indicador 'ciclo de facturación' (P90 en horas).</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#39;esRefacturacion&#39;, false)}" event="end" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_ConsumoValidado" messageRef="Message_ConsumoValidado" />
    </bpmn:startEvent>
    <bpmn:startEvent id="StartEvent_Refacturacion" name="Refacturación autorizada recibida">
      <bpmn:documentation>Interfaces de entrada C6 (refacturación autorizada) y C7 (ajuste autorizado). Genera una nueva versión de factura del mismo suministro-período sin duplicar la cuenta por cobrar.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#39;esRefacturacion&#39;, true)}" event="end" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Refacturacion" messageRef="Message_Refacturacion" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_JoinInicio">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_ConsolidarInsumos" name="Consolidar insumos de facturación" camunda:delegateExpression="${consolidarInsumos}">
      <bpmn:documentation>Primera actividad del perfil de C4: recibir el consumo validado y obtener la versión vigente de la regla tarifaria (G3) y el histórico del suministro (C3). Calcula la desviación frente al promedio y fija los plazos de los temporizadores.</bpmn:documentation>
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
      <bpmn:property id="Property_ConsolidarInsumos_0" name="__targetRef_placeholder" />
      <bpmn:property id="Property_ConsolidarInsumos_1" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_Historico_ConsolidarInsumos">
        <bpmn:sourceRef>DataStoreReference_Historico</bpmn:sourceRef>
        <bpmn:targetRef>Property_ConsolidarInsumos_0</bpmn:targetRef>
      </bpmn:dataInputAssociation>
      <bpmn:dataInputAssociation id="DataInputAssociation_Reglas_ConsolidarInsumos">
        <bpmn:sourceRef>DataStoreReference_Reglas</bpmn:sourceRef>
        <bpmn:targetRef>Property_ConsolidarInsumos_1</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Event_ReglaNoVigente" name="Regla tarifaria vigente no encontrada" attachedToRef="Activity_ConsolidarInsumos">
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_ReglaNoVigente" errorRef="Error_ReglaNoVigente" camunda:errorCodeVariable="codigoError" camunda:errorMessageVariable="mensajeError" />
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="Event_SolicitudReglaG3" name="Solicitud de regla tarifaria enviada a G3">
      <bpmn:documentation>No se factura con una regla no vigente: se solicita a G3 la regla autorizada (indicador de flexibilidad 'adaptación a una regla autorizada').</bpmn:documentation>
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_SolicitudRegla" messageRef="Message_SolicitudRegla" camunda:delegateExpression="${solicitarReglaG3}" />
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="Activity_ClasificarConsumo" name="Clasificar consumo para facturación" camunda:resultVariable="resultadoClasificacion" camunda:decisionRef="ClasificarConsumo" camunda:decisionRefBinding="deployment" camunda:mapDecisionResult="singleResult">
      <bpmn:documentation>Tabla DMN ClasificarConsumo (hit policy FIRST): estimaciones y desviaciones significativas, los motivos recurrentes de las reclamaciones por facturación.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="decisionConsumo">${resultadoClasificacion.decisionConsumo}</camunda:outputParameter>
          <camunda:outputParameter name="motivoExcepcion">${resultadoClasificacion.motivoExcepcion}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Tratamiento" name="¿Cómo se trata el consumo?">
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_RevisarExcepcion" name="Revisar excepción de consumo" camunda:formRef="RevisarExcepcionConsumo" camunda:formRefBinding="deployment" camunda:candidateGroups="analistas-facturacion">
      <bpmn:documentation>El analista de facturación decide con evidencia si la excepción se factura o se devuelve a C3. No se atribuyen a facturación errores de otra etapa sin evidencia. Al iniciar se elimina la decisión de una revisión anterior (tras DEVOLVER_C3 y la corrección de C3), para que el formulario vuelva a mostrar sus valores por defecto.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.removeVariable(&#39;decisionAnalista&#39;)}" event="start" />
        <camunda:executionListener expression="${execution.removeVariable(&#39;evidenciaAnalista&#39;)}" event="start" />
        <camunda:taskListener delegateExpression="${validarFormularioC4}" event="complete" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_DecisionAnalista" name="¿Dónde se resuelve la excepción?">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinDevolver">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Event_ExcepcionDevueltaC3" name="Excepción devuelta a C3">
      <bpmn:documentation>Alcance del primer paso de C4: devolver las excepciones a C3 con su motivo.</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_ExcepcionC3" messageRef="Message_ExcepcionConsumo" camunda:delegateExpression="${devolverExcepcionC3}" />
    </bpmn:intermediateThrowEvent>
    <bpmn:eventBasedGateway id="Gateway_EsperaC3">
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_ConsumoCorregido" name="Consumo corregido recibido">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_ConsumoCorregido" messageRef="Message_ConsumoCorregido" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_PlazoC3Vencido" name="Plazo de respuesta de C3 vencido">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_PlazoC3">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${plazoEsperaC3}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Activity_AsignarConsumoPromedio" name="Asignar consumo promedio (art. 149 Ley 142)" camunda:delegateExpression="${asignarConsumoPromedio}">
      <bpmn:documentation>Mientras se establece la causa de la desviación, la factura se hace con el consumo promedio y se marca como provisional; las diferencias se abonan o cargan después (art. 149, Ley 142 de 1994).</bpmn:documentation>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_JoinFacturar">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinTarifa">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Activity_DeterminarTarifa" name="Determinar tarifa aplicable" camunda:resultVariable="resultadoTarifa" camunda:decisionRef="DeterminarTarifaAplicable" camunda:decisionRefBinding="deployment" camunda:mapDecisionResult="singleResult">
      <bpmn:documentation>Tabla DMN DeterminarTarifaAplicable (hit policy UNIQUE): subsidio o contribución por uso y estrato, según la regla versionada de G3.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="factorSubsidioContribucion">${resultadoTarifa.factorSubsidioContribucion}</camunda:outputParameter>
          <camunda:outputParameter name="tipoAjusteTarifario">${resultadoTarifa.tipoAjusteTarifario}</camunda:outputParameter>
          <camunda:outputParameter name="consumoSubsistenciaKwh">${resultadoTarifa.consumoSubsistenciaKwh}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Activity_LiquidarFactura" name="Liquidar factura" camunda:delegateExpression="${liquidarFactura}">
      <bpmn:documentation>Motor de liquidación: el delegate liquidarFactura invoca el servicio Core (POST /api/core/liquidaciones). Valor = CU x kWh, con subsidio sobre el consumo de subsistencia o contribución sobre todo el consumo.</bpmn:documentation>
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Activity_VerificarCalidad" name="Verificar calidad de la factura" camunda:formRef="VerificarCalidadFactura" camunda:formRefBinding="deployment" camunda:candidateGroups="calidad-facturacion">
      <bpmn:documentation>Control de calidad previo a la emisión (indicador 'factura correcta a la primera'). Al iniciar se elimina el dictamen de una verificación anterior (tras CORREGIR), para que el formulario vuelva a mostrar sus valores por defecto; motivoCorreccion se conserva como evidencia de la corrección.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.removeVariable(&#39;resultadoVerificacion&#39;)}" event="start" />
        <camunda:executionListener expression="${execution.removeVariable(&#39;observacionCalidad&#39;)}" event="start" />
        <camunda:taskListener delegateExpression="${validarFormularioC4}" event="complete" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Event_SlaCalidadVencido" name="SLA de verificación vencido" cancelActivity="false" attachedToRef="Activity_VerificarCalidad">
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_SlaCalidad">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">${plazoSlaCalidad}</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Activity_EscalarCoordinador" name="Escalar verificación al coordinador" camunda:delegateExpression="${escalarCoordinador}">
      <bpmn:documentation>El temporizador no interrumpe la verificación: solo avisa al coordinador para proteger el ciclo de facturación.</bpmn:documentation>
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_VerificacionEscalada" name="Verificación escalada">
      <bpmn:incoming>Flow_29</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_Calidad" name="¿La factura es correcta?">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_CorregirLiquidacion" name="Corregir liquidación" camunda:formRef="CorregirLiquidacion" camunda:formRefBinding="deployment" camunda:candidateGroups="liquidadores-tarifarios">
      <bpmn:documentation>Registra la corrección autorizada y su motivo; la factura se reliquida y vuelve a verificación. Al iniciar se elimina la descripción de una corrección anterior, para que el formulario vuelva a mostrar su valor por defecto.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.removeVariable(&#39;descripcionCorreccion&#39;)}" event="start" />
        <camunda:executionListener expression="${execution.setVariable(&#39;correccionesPreEmision&#39;, correccionesPreEmision + 1)}" event="end" />
        <camunda:taskListener delegateExpression="${validarFormularioC4}" event="complete" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_EmitirFactura" name="Emitir factura" camunda:delegateExpression="${emitirFactura}">
      <bpmn:documentation>Asigna número y versión de factura; la refacturación crea una versión nueva del mismo suministro-período.</bpmn:documentation>
      <bpmn:incoming>Flow_25</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_EmitirFactura_Factura">
        <bpmn:targetRef>DataObjectReference_Factura</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_SplitEmision">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="Activity_EntregarFactura" name="Entregar factura con prueba de entrega" calledElement="C4_EntregarFactura">
      <bpmn:documentation>Última actividad del perfil de C4. Proceso global reutilizable C4_EntregarFactura (Call Activity), que también usa la refacturación.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:serviceTask id="Activity_RegistrarExpediente" name="Registrar expediente de trazabilidad" camunda:delegateExpression="${registrarExpediente}">
      <bpmn:documentation>Interfaz de salida C7: evidencia ante controversias de cobro. Conserva identificador del caso, versión de regla, lectura, factura y marcas de tiempo (regla de trazabilidad 8.4).</bpmn:documentation>
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_RegistrarExpediente_Expediente">
        <bpmn:targetRef>DataStoreReference_Expediente</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="Event_CuentaPorCobrarC5" name="Cuenta por cobrar enviada a C5">
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_CuentaC5" messageRef="Message_CuentaPorCobrar" camunda:delegateExpression="${notificarC5}" />
    </bpmn:intermediateThrowEvent>
    <bpmn:parallelGateway id="Gateway_JoinEmision" camunda:asyncBefore="true">
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="Event_FacturaEntregada" name="Factura verificada, emitida y entregada">
      <bpmn:incoming>Flow_37</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStoreReference_Historico" name="Histórico de lecturas y consumos (C3)" />
    <bpmn:dataStoreReference id="DataStoreReference_Reglas" name="Reglas tarifarias versionadas (G3)" />
    <bpmn:dataStoreReference id="DataStoreReference_Expediente" name="Expediente de facturación" />
    <bpmn:dataObject id="DataObject_Factura" />
    <bpmn:dataObjectReference id="DataObjectReference_Factura" name="Factura [emitida]" dataObjectRef="DataObject_Factura" />
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_ConsumoValidado" targetRef="Gateway_JoinInicio" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="StartEvent_Refacturacion" targetRef="Gateway_JoinInicio" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_JoinInicio" targetRef="Activity_ConsolidarInsumos" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Activity_ConsolidarInsumos" targetRef="Activity_ClasificarConsumo" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Event_ReglaNoVigente" targetRef="Event_SolicitudReglaG3" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Activity_ClasificarConsumo" targetRef="Gateway_Tratamiento" />
    <bpmn:sequenceFlow id="Flow_07" name="Facturar" sourceRef="Gateway_Tratamiento" targetRef="Gateway_JoinFacturar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisionConsumo == 'FACTURAR'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08" name="Revisar" sourceRef="Gateway_Tratamiento" targetRef="Activity_RevisarExcepcion">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisionConsumo == 'REVISAR_ANALISTA'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09" name="Devolver a C3" sourceRef="Gateway_Tratamiento" targetRef="Gateway_JoinDevolver">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisionConsumo == 'DEVOLVER_C3'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Activity_RevisarExcepcion" targetRef="Gateway_DecisionAnalista" />
    <bpmn:sequenceFlow id="Flow_11" name="Variación justificada" sourceRef="Gateway_DecisionAnalista" targetRef="Gateway_JoinFacturar">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisionAnalista == 'FACTURAR'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" name="Origen en la medición" sourceRef="Gateway_DecisionAnalista" targetRef="Gateway_JoinDevolver">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${decisionAnalista == 'DEVOLVER_C3'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Gateway_JoinDevolver" targetRef="Event_ExcepcionDevueltaC3" />
    <bpmn:sequenceFlow id="Flow_14" sourceRef="Event_ExcepcionDevueltaC3" targetRef="Gateway_EsperaC3" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Gateway_EsperaC3" targetRef="Event_ConsumoCorregido" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Gateway_EsperaC3" targetRef="Event_PlazoC3Vencido" />
    <bpmn:sequenceFlow id="Flow_17" sourceRef="Event_ConsumoCorregido" targetRef="Gateway_JoinInicio" />
    <bpmn:sequenceFlow id="Flow_18" sourceRef="Event_PlazoC3Vencido" targetRef="Activity_AsignarConsumoPromedio" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Activity_AsignarConsumoPromedio" targetRef="Gateway_JoinFacturar" />
    <bpmn:sequenceFlow id="Flow_20" sourceRef="Gateway_JoinFacturar" targetRef="Gateway_JoinTarifa" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Gateway_JoinTarifa" targetRef="Activity_DeterminarTarifa" />
    <bpmn:sequenceFlow id="Flow_22" sourceRef="Activity_DeterminarTarifa" targetRef="Activity_LiquidarFactura" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Activity_LiquidarFactura" targetRef="Activity_VerificarCalidad" />
    <bpmn:sequenceFlow id="Flow_24" sourceRef="Activity_VerificarCalidad" targetRef="Gateway_Calidad" />
    <bpmn:sequenceFlow id="Flow_25" name="Aprobada" sourceRef="Gateway_Calidad" targetRef="Activity_EmitirFactura">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resultadoVerificacion == 'APROBADA'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_26" name="Corregir" sourceRef="Gateway_Calidad" targetRef="Activity_CorregirLiquidacion">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resultadoVerificacion == 'CORREGIR'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_27" sourceRef="Activity_CorregirLiquidacion" targetRef="Gateway_JoinTarifa" />
    <bpmn:sequenceFlow id="Flow_28" sourceRef="Event_SlaCalidadVencido" targetRef="Activity_EscalarCoordinador" />
    <bpmn:sequenceFlow id="Flow_29" sourceRef="Activity_EscalarCoordinador" targetRef="Event_VerificacionEscalada" />
    <bpmn:sequenceFlow id="Flow_30" sourceRef="Activity_EmitirFactura" targetRef="Gateway_SplitEmision" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Gateway_SplitEmision" targetRef="Activity_EntregarFactura" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Gateway_SplitEmision" targetRef="Activity_RegistrarExpediente" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Gateway_SplitEmision" targetRef="Event_CuentaPorCobrarC5" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Activity_EntregarFactura" targetRef="Gateway_JoinEmision" />
    <bpmn:sequenceFlow id="Flow_35" sourceRef="Activity_RegistrarExpediente" targetRef="Gateway_JoinEmision" />
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Event_CuentaPorCobrarC5" targetRef="Gateway_JoinEmision" />
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Gateway_JoinEmision" targetRef="Event_FacturaEntregada" />
    <bpmn:textAnnotation id="TextAnnotation_Disparadores">
      <bpmn:text>Dos disparadores y una misma unidad de caso (suministro-período): consumo validado desde C3, o refacturación/ajuste autorizado desde C6/C7. t0 = liberación del consumo en C3 (ciclo de facturación, P90).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Art149">
      <bpmn:text>Art. 149 Ley 142/1994: se investigan las desviaciones significativas. Mientras se establece la causa, se factura por promedio (factura provisional).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Calidad">
      <bpmn:text>Indicador 'factura correcta a la primera': se registra el motivo de cada corrección. Los errores de medición no se corrigen aquí (no se atribuyen sin evidencia).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_C5">
      <bpmn:text>Una sola cuenta por cobrar por suministro-período: una refacturación envía a C5 una nueva versión, no otra cuenta.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Resultado">
      <bpmn:text>Resultado (outcome): factura verificada, emitida y entregada con prueba de entrega registrada. El expediente es la evidencia para C7 ante controversias de cobro.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Disparadores" associationDirection="None" sourceRef="TextAnnotation_Disparadores" targetRef="StartEvent_Refacturacion" />
    <bpmn:association id="Association_Art149" associationDirection="None" sourceRef="TextAnnotation_Art149" targetRef="Activity_AsignarConsumoPromedio" />
    <bpmn:association id="Association_Calidad" associationDirection="None" sourceRef="TextAnnotation_Calidad" targetRef="Activity_VerificarCalidad" />
    <bpmn:association id="Association_C5" associationDirection="None" sourceRef="TextAnnotation_C5" targetRef="Event_CuentaPorCobrarC5" />
    <bpmn:association id="Association_Resultado" associationDirection="None" sourceRef="TextAnnotation_Resultado" targetRef="Event_FacturaEntregada" />
  </bpmn:process>
