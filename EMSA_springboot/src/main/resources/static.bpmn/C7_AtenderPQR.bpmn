<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_C7_AtenderPQR" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.39.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.20.0">
  <bpmn:collaboration id="Collaboration_C7">
    <bpmn:participant id="Participant_C7" name="ENEL La Corocora · Gerencia Comercial (Oficina de Peticiones, Quejas y Recursos) — C7 · Atender una PQR del usuario" processRef="C7_AtenderPQR">
      <bpmn:documentation>Proceso core seleccionado (I/S/F = 5/5/5). Dueño: Gerencia Comercial, Oficina de Peticiones, Quejas y Recursos (art. 153, Ley 142 de 1994). Caso: una PQR con radicado único. Resultado: respuesta notificada dentro del término aplicable y trámite concluido, o remitido cuando procede el recurso de apelación.</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_Usuario" name="Usuario / suscriptor (peticionario)" />
    <bpmn:participant id="Participant_SSPD" name="SSPD · Superintendencia de Servicios Públicos Domiciliarios" />
    <bpmn:participant id="Participant_S4" name="S4 · Atender un requerimiento jurídico" />
    <bpmn:participant id="Participant_FuenteEvidencia" name="Proceso fuente de la evidencia según el asunto (C2 · C3 · C4 · C5 · C6)" />
    <bpmn:participant id="Participant_C4" name="C4 · Facturar el servicio de energía" />
    <bpmn:participant id="Participant_C6" name="C6 · Investigar y normalizar una anomalía de medida" />
    <bpmn:participant id="Participant_G1" name="G1 · Revisar y aprobar el plan estratégico" />
    <bpmn:participant id="Participant_G3" name="G3 · Actualizar el marco de riesgos y cumplimiento" />
    <bpmn:messageFlow id="MessageFlow_PQRVentanilla" name="PQR presencial o telefónica" sourceRef="Participant_Usuario" targetRef="StartEvent_PQRVentanilla" />
    <bpmn:messageFlow id="MessageFlow_PQRPortal" name="PQR con adjuntos por el portal" sourceRef="Participant_Usuario" targetRef="StartEvent_PQRPortal" />
    <bpmn:messageFlow id="MessageFlow_Constancia" name="Constancia de radicado y término" sourceRef="Event_ConstanciaRadicado" targetRef="Participant_Usuario" />
    <bpmn:messageFlow id="MessageFlow_Decision" name="Decisión notificada" sourceRef="CallActivity_Notificar" targetRef="Participant_Usuario" />
    <bpmn:messageFlow id="MessageFlow_Recurso" name="Recurso de reposición" sourceRef="Participant_Usuario" targetRef="Event_RecursoRecibido" />
    <bpmn:messageFlow id="MessageFlow_SolicitudEvidencia" name="Solicitud de evidencia" sourceRef="Event_SolicitudEvidencia" targetRef="Participant_FuenteEvidencia" />
    <bpmn:messageFlow id="MessageFlow_Evidencia" name="Evidencia del asunto" sourceRef="Participant_FuenteEvidencia" targetRef="Event_EvidenciaRecibida" />
    <bpmn:messageFlow id="MessageFlow_AjusteC4" name="Ajuste autorizado" sourceRef="Event_AjusteC4" targetRef="Participant_C4" />
    <bpmn:messageFlow id="MessageFlow_RevisionC6" name="Revisión de la actuación" sourceRef="Event_RevisionC6" targetRef="Participant_C6" />
    <bpmn:messageFlow id="MessageFlow_ApelacionSSPD" name="Expediente de apelación" sourceRef="Event_RemitirSSPD" targetRef="Participant_SSPD" />
    <bpmn:messageFlow id="MessageFlow_DefensaS4" name="Expediente para la defensa" sourceRef="Event_RemitirSSPD" targetRef="Participant_S4" />
    <bpmn:messageFlow id="MessageFlow_CausasG1" name="Causas agregadas" sourceRef="EndEvent_PQRConcluida" targetRef="Participant_G1" />
    <bpmn:messageFlow id="MessageFlow_CausasG3" name="Causas recurrentes" sourceRef="EndEvent_PQRConcluida" targetRef="Participant_G3" />
    <bpmn:textAnnotation id="TextAnnotation_Canales">
      <bpmn:text>Radicación integral en los tres canales (hallazgos SSPD 2024): por teléfono se radica cualquier tipo de PQR, no solo daños, y el portal admite adjuntos y ajustes de accesibilidad. El canal no crea otro proceso (§7.1).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Canales" associationDirection="None" sourceRef="TextAnnotation_Canales" targetRef="Activity_RadicarPQR" />
    <bpmn:textAnnotation id="TextAnnotation_Tipificar">
      <bpmn:text>Término aplicable: 15 días hábiles (art. 158, Ley 142). Las alertas de procedencia no rechazan la PQR: ninguna decisión desfavorable se automatiza (§10).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Tipificar" associationDirection="None" sourceRef="TextAnnotation_Tipificar" targetRef="Activity_TipificarPQR" />
    <bpmn:textAnnotation id="TextAnnotation_Alerta">
      <bpmn:text>Control de términos: alerta a la coordinación cuando se consume el 70 % del término (oportunidad de respuesta y capacidad ante picos, §8.3).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Alerta" associationDirection="None" sourceRef="TextAnnotation_Alerta" targetRef="Activity_AlertarCoordinador" />
    <bpmn:textAnnotation id="TextAnnotation_SAP">
      <bpmn:text>Art. 158, Ley 142: si el término vence sin respuesta, opera el silencio administrativo positivo. La empresa reconoce sus efectos a favor del usuario.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_SAP" associationDirection="None" sourceRef="TextAnnotation_SAP" targetRef="Activity_ReconocerSilencio" />
    <bpmn:textAnnotation id="TextAnnotation_Notificacion">
      <bpmn:text>No se cierra un caso por el solo hecho de enviar un mensaje (§10): la decisión se notifica con prueba (C7.1). Las acciones en C4 y C6 corren en paralelo.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Notificacion" associationDirection="None" sourceRef="TextAnnotation_Notificacion" targetRef="CallActivity_Notificar" />
    <bpmn:textAnnotation id="TextAnnotation_Recurso">
      <bpmn:text>Art. 154, Ley 142: reposición ante la empresa y apelación en subsidio ante la SSPD, dentro de los 5 días hábiles siguientes a la notificación. El recurso vuelve a la radicación en el mismo expediente.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Recurso" associationDirection="None" sourceRef="TextAnnotation_Recurso" targetRef="Gateway_EsperaRecurso" />
    <bpmn:textAnnotation id="TextAnnotation_Indicadores">
      <bpmn:text>Indicadores (§8.3): oportunidad de respuesta, reapertura por la misma causa (30 días), costo por PQR terminada y capacidad ante picos. Un denominador cero se reporta como ND.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Indicadores" associationDirection="None" sourceRef="TextAnnotation_Indicadores" targetRef="Activity_CerrarExpediente" />
  </bpmn:collaboration>
  <bpmn:process id="C7_AtenderPQR" name="C7 · Atender una PQR del usuario" isExecutable="true" camunda:versionTag="1.0" camunda:historyTimeToLive="180">
    <bpmn:documentation>Garantizar que toda petición, queja o reclamo reciba una decisión motivada y notificada dentro de su término legal, con un expediente que permita demostrar cómo se llegó a ella (perfil de C7, documento de identificación de procesos de ENEL La Corocora).</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_C7_AtenderPQR">
      <bpmn:lane id="Lane_Sistema" name="Sistema de gestión de PQR · gestor de expedientes">
        <bpmn:flowNodeRef>StartEvent_PQRPortal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinCanales</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinRecurso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RadicarPQR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinTipificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_TipificarPQR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Tipificacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_AbrirExpediente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ConstanciaRadicado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SplitEjecucion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CallActivity_Notificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OrdenaAjuste</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_AjusteC4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinAjuste</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SolicitaRevision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_RevisionC6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinRevision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinEjecucion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EsperaRecurso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Recurso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_PlazoRecursoVencido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinCierre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Apelacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_RemitirSSPD</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinFinal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_CerrarExpediente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_PQRConcluida</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Juridico" name="Apoyo jurídico de PQR">
        <bpmn:flowNodeRef>SubProcess_Instruir</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Analista" name="Analista de PQR">
        <bpmn:flowNodeRef>Activity_AlertarCoordinador</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CoordinadorAlertado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ReconocerSilencio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_TerminoVencido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_AlertaTermino</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Orientador" name="Orientador y enrutador de usuarios">
        <bpmn:flowNodeRef>StartEvent_PQRVentanilla</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_TipificarManual</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_RecursoRecibido</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_PQRVentanilla" name="PQR recibida en ventanilla o por teléfono" camunda:formRef="RadicarPQR" camunda:formRefBinding="deployment" camunda:initiator="orientadorRadicador">
      <bpmn:documentation>Disparador de C7 por los canales presencial y telefónico. El orientador diligencia el Camunda Form «Radicar PQR» (formulario de inicio). Radicación integral: por teléfono se radica cualquier tipo de PQR, no solo el reporte de daños (hallazgo de la SSPD sobre la vigencia 2024).</bpmn:documentation>
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:startEvent id="StartEvent_PQRPortal" name="PQR recibida por el portal virtual">
      <bpmn:documentation>Disparador de C7 por el canal virtual (mensaje MsgPQRPortal). El portal admite adjuntos y ajustes de accesibilidad, las dos carencias que señaló la SSPD. El canal no crea otro proceso: ambos inicios convergen en la misma radicación (§7.1).</bpmn:documentation>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_PQRPortal" messageRef="Message_PQRPortal" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_JoinCanales">
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_JoinRecurso">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:incoming>Flow_50</bpmn:incoming>
      <bpmn:outgoing>Flow_04</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_RadicarPQR" name="Radicar la PQR y asignar radicado" camunda:delegateExpression="${radicarPqr}">
      <bpmn:documentation>Primera actividad del perfil de C7: radicar la petición y asignar radicado. Asigna radicado único y expediente (business key), calcula los meses desde la expedición de la factura reclamada y detecta si es una reapertura por la misma causa (mismo suministro y asunto cerrado hace 30 días o menos). Si llega un recurso, radica el recurso en el mismo expediente.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setProcessBusinessKey(expedienteId)}" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_04</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_JoinTipificar">
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:businessRuleTask id="Activity_TipificarPQR" name="Tipificar la PQR y fijar el término" camunda:resultVariable="resultadoTipificacion" camunda:decisionRef="TipificarPQR" camunda:decisionRefBinding="deployment" camunda:mapDecisionResult="singleResult">
      <bpmn:documentation>Tabla DMN TipificarPQR (hit policy FIRST). Fija el término aplicable en días hábiles, el proceso fuente de la evidencia (C2, C3, C4, C5 o C6), la prioridad, si la revisión jurídica es obligatoria y las alertas de procedencia. Las alertas no rechazan la PQR: no se automatizan decisiones desfavorables (§10).</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="tipificacionConcluyente">${resultadoTipificacion.tipificacionConcluyente}</camunda:outputParameter>
          <camunda:outputParameter name="terminoDiasHabiles">${resultadoTipificacion.terminoDiasHabiles}</camunda:outputParameter>
          <camunda:outputParameter name="procesoEvidencia">${resultadoTipificacion.procesoEvidencia}</camunda:outputParameter>
          <camunda:outputParameter name="plazoEvidenciaDiasHabiles">${resultadoTipificacion.plazoEvidenciaDiasHabiles}</camunda:outputParameter>
          <camunda:outputParameter name="requiereRevisionJuridica">${resultadoTipificacion.requiereRevisionJuridica}</camunda:outputParameter>
          <camunda:outputParameter name="prioridad">${resultadoTipificacion.prioridad}</camunda:outputParameter>
          <camunda:outputParameter name="alertaProcedencia">${resultadoTipificacion.alertaProcedencia}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_06</bpmn:incoming>
      <bpmn:outgoing>Flow_07</bpmn:outgoing>
      <bpmn:property id="Property_Activity_TipificarPQR_0" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_Reglas">
        <bpmn:sourceRef>DataStoreReference_ReglasG3</bpmn:sourceRef>
        <bpmn:targetRef>Property_Activity_TipificarPQR_0</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Tipificacion" name="¿La tipificación es concluyente?">
      <bpmn:incoming>Flow_07</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Activity_TipificarManual" name="Tipificar y enrutar la PQR" camunda:formRef="TipificarEnrutarPQR" camunda:formRefBinding="deployment" camunda:candidateGroups="orientadores-pqr">
      <bpmn:documentation>El orientador y enrutador de usuarios corrige el tipo y el asunto cuando la regla no los reconoce (asunto «Otro» o combinación no prevista). Después la PQR vuelve a la tabla DMN.</bpmn:documentation>
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Activity_AbrirExpediente" name="Abrir expediente y calcular vencimiento" camunda:delegateExpression="${abrirExpediente}">
      <bpmn:documentation>Abre (o actualiza, si es un recurso) el expediente único y calcula en días hábiles colombianos la fecha de vencimiento del término y la fecha de alerta (70 %). Registra identificador del caso, evento, responsable, fecha-hora, estado y versión (regla de trazabilidad, §8.4).</bpmn:documentation>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Expediente">
        <bpmn:targetRef>DataStoreReference_Expedientes</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:intermediateThrowEvent id="Event_ConstanciaRadicado" name="Constancia de radicado enviada al usuario">
      <bpmn:documentation>Soporte al usuario (§10): número de radicado, tipo, término aplicable y fecha de vencimiento, para que pueda conocer el estado de su caso.</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Constancia" messageRef="Message_ConstanciaRadicado" camunda:delegateExpression="${enviarConstanciaRadicado}" />
    </bpmn:intermediateThrowEvent>
    <bpmn:subProcess id="SubProcess_Instruir" name="Instruir y decidir la PQR">
      <bpmn:documentation>Subproceso embebido. Reúne la evidencia y produce una decisión motivada y revisada. Está protegido por dos temporizadores de borde: la alerta del 70 % del término (no interrumpe) y el vencimiento del término legal (interrumpe y activa el silencio administrativo positivo).</bpmn:documentation>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_Instruir" name="Instrucción iniciada">
        <bpmn:outgoing>Flow_13</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:exclusiveGateway id="Gateway_RequiereEvidencia" name="¿Requiere evidencia de otro proceso?">
        <bpmn:incoming>Flow_13</bpmn:incoming>
        <bpmn:outgoing>Flow_14</bpmn:outgoing>
        <bpmn:outgoing>Flow_15</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:intermediateThrowEvent id="Event_SolicitudEvidencia" name="Evidencia solicitada al proceso fuente">
        <bpmn:documentation>C7 solicita evidencia o ajustes a C2, C3, C4, C5 o C6 según el asunto (cadena de valor CV4). El proceso destino lo fija la tabla DMN (procesoEvidencia).</bpmn:documentation>
        <bpmn:incoming>Flow_14</bpmn:incoming>
        <bpmn:outgoing>Flow_16</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_SolicitudEvidencia" messageRef="Message_SolicitudEvidencia" camunda:delegateExpression="${solicitarEvidencia}" />
      </bpmn:intermediateThrowEvent>
      <bpmn:eventBasedGateway id="Gateway_EsperaEvidencia" name="¿Llega la evidencia a tiempo?">
        <bpmn:incoming>Flow_16</bpmn:incoming>
        <bpmn:outgoing>Flow_17</bpmn:outgoing>
        <bpmn:outgoing>Flow_18</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="Event_PlazoEvidenciaVencido" name="Plazo interno de evidencia vencido">
        <bpmn:documentation>Plazo interno (1 a 3 días hábiles según la tabla DMN) para que el proceso fuente entregue la evidencia, dentro del término legal.</bpmn:documentation>
        <bpmn:incoming>Flow_17</bpmn:incoming>
        <bpmn:outgoing>Flow_19</bpmn:outgoing>
        <bpmn:timerEventDefinition id="TimerEventDefinition_PlazoEvidencia">
          <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${fechaLimiteEvidencia}</bpmn:timeDate>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:serviceTask id="Activity_EscalarEvidencia" name="Escalar al dueño del proceso fuente" camunda:delegateExpression="${escalarEvidencia}">
        <bpmn:documentation>Avisa al dueño del proceso fuente y deja constancia de que la evidencia no llegó a tiempo (evidenciaOportuna = false). El analista continúa con la evidencia disponible: la falta de evidencia de la empresa no se resuelve en contra del usuario.</bpmn:documentation>
        <bpmn:incoming>Flow_19</bpmn:incoming>
        <bpmn:outgoing>Flow_20</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:intermediateCatchEvent id="Event_EvidenciaRecibida" name="Evidencia recibida">
        <bpmn:documentation>Mensaje MsgEvidenciaPQR del proceso fuente con la evidencia del asunto (por ejemplo, la trazabilidad de la factura en C4).</bpmn:documentation>
        <bpmn:incoming>Flow_18</bpmn:incoming>
        <bpmn:outgoing>Flow_21</bpmn:outgoing>
        <bpmn:messageEventDefinition id="MessageEventDefinition_EvidenciaPQR" messageRef="Message_EvidenciaPQR" />
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="Gateway_JoinEvidencia">
        <bpmn:incoming>Flow_15</bpmn:incoming>
        <bpmn:incoming>Flow_20</bpmn:incoming>
        <bpmn:incoming>Flow_21</bpmn:incoming>
        <bpmn:outgoing>Flow_22</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="Gateway_JoinProyectar">
        <bpmn:incoming>Flow_22</bpmn:incoming>
        <bpmn:incoming>Flow_29</bpmn:incoming>
        <bpmn:outgoing>Flow_23</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Activity_ProyectarRespuesta" name="Analizar y proyectar la respuesta" camunda:formRef="ProyectarRespuestaPQR" camunda:formRefBinding="deployment" camunda:candidateGroups="analistas-pqr">
        <bpmn:documentation>El analista de PQR valora la evidencia y proyecta una decisión motivada: sentido, motivación, acciones en otros procesos (ajuste en C4, revisión de la actuación en C6) y causa raíz para G1 y G3. Al terminar se limpia el resultado de la revisión anterior, para que una nueva revisión jurídica (tras DEVOLVER) empiece con los valores por defecto del formulario.</bpmn:documentation>
        <bpmn:extensionElements>
          <camunda:executionListener expression="${execution.removeVariable('resultadoRevision')}" event="end" />
          <camunda:executionListener expression="${execution.removeVariable('observacionesRevision')}" event="end" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_23</bpmn:incoming>
        <bpmn:outgoing>Flow_24</bpmn:outgoing>
        <bpmn:property id="Property_Activity_ProyectarRespuesta_0" name="__targetRef_placeholder" />
        <bpmn:dataInputAssociation id="DataInputAssociation_Historico">
          <bpmn:sourceRef>DataStoreReference_Historico</bpmn:sourceRef>
          <bpmn:targetRef>Property_Activity_ProyectarRespuesta_0</bpmn:targetRef>
        </bpmn:dataInputAssociation>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_RequiereRevision" name="¿Requiere revisión jurídica?">
        <bpmn:incoming>Flow_24</bpmn:incoming>
        <bpmn:outgoing>Flow_25</bpmn:outgoing>
        <bpmn:outgoing>Flow_26</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:userTask id="Activity_RevisarJuridica" name="Revisar el debido proceso del proyecto" camunda:formRef="RevisarProyectoRespuesta" camunda:formRefBinding="deployment" camunda:candidateGroups="juridica-pqr">
        <bpmn:documentation>Ninguna decisión desfavorable se emite sin revisión humana de debido proceso (§10). También se revisan las respuestas parciales, las reaperturas por la misma causa y los recursos.</bpmn:documentation>
        <bpmn:incoming>Flow_25</bpmn:incoming>
        <bpmn:outgoing>Flow_27</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_ProyectoAprobado" name="¿El proyecto se aprueba?">
        <bpmn:incoming>Flow_27</bpmn:incoming>
        <bpmn:outgoing>Flow_28</bpmn:outgoing>
        <bpmn:outgoing>Flow_29</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="Gateway_JoinFinInstruccion">
        <bpmn:incoming>Flow_26</bpmn:incoming>
        <bpmn:incoming>Flow_28</bpmn:incoming>
        <bpmn:outgoing>Flow_30</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="EndEvent_Instruccion" name="Decisión aprobada">
        <bpmn:incoming>Flow_30</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:dataStoreReference id="DataStoreReference_Historico" name="Histórico del suministro y evidencias del caso" dataStoreRef="DataStore_Historico" />
      <bpmn:sequenceFlow id="Flow_13" sourceRef="StartEvent_Instruir" targetRef="Gateway_RequiereEvidencia" />
      <bpmn:sequenceFlow id="Flow_14" name="Sí" sourceRef="Gateway_RequiereEvidencia" targetRef="Event_SolicitudEvidencia">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${procesoEvidencia != 'NINGUNO'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_15" name="No" sourceRef="Gateway_RequiereEvidencia" targetRef="Gateway_JoinEvidencia">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${procesoEvidencia == 'NINGUNO'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_16" sourceRef="Event_SolicitudEvidencia" targetRef="Gateway_EsperaEvidencia" />
      <bpmn:sequenceFlow id="Flow_17" sourceRef="Gateway_EsperaEvidencia" targetRef="Event_PlazoEvidenciaVencido" />
      <bpmn:sequenceFlow id="Flow_18" sourceRef="Gateway_EsperaEvidencia" targetRef="Event_EvidenciaRecibida" />
      <bpmn:sequenceFlow id="Flow_19" sourceRef="Event_PlazoEvidenciaVencido" targetRef="Activity_EscalarEvidencia" />
      <bpmn:sequenceFlow id="Flow_20" sourceRef="Activity_EscalarEvidencia" targetRef="Gateway_JoinEvidencia" />
      <bpmn:sequenceFlow id="Flow_21" sourceRef="Event_EvidenciaRecibida" targetRef="Gateway_JoinEvidencia" />
      <bpmn:sequenceFlow id="Flow_22" sourceRef="Gateway_JoinEvidencia" targetRef="Gateway_JoinProyectar" />
      <bpmn:sequenceFlow id="Flow_23" sourceRef="Gateway_JoinProyectar" targetRef="Activity_ProyectarRespuesta" />
      <bpmn:sequenceFlow id="Flow_24" sourceRef="Activity_ProyectarRespuesta" targetRef="Gateway_RequiereRevision" />
      <bpmn:sequenceFlow id="Flow_25" name="Sí: desfavorable, parcial, reapertura o recurso" sourceRef="Gateway_RequiereRevision" targetRef="Activity_RevisarJuridica">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${sentidoDecision != 'FAVORABLE' || requiereRevisionJuridica || esReapertura}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_26" name="No" sourceRef="Gateway_RequiereRevision" targetRef="Gateway_JoinFinInstruccion">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${sentidoDecision == 'FAVORABLE' &amp;&amp; !requiereRevisionJuridica &amp;&amp; !esReapertura}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_27" sourceRef="Activity_RevisarJuridica" targetRef="Gateway_ProyectoAprobado" />
      <bpmn:sequenceFlow id="Flow_28" name="Aprobar" sourceRef="Gateway_ProyectoAprobado" targetRef="Gateway_JoinFinInstruccion">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resultadoRevision == 'APROBAR'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_29" name="Devolver al analista" sourceRef="Gateway_ProyectoAprobado" targetRef="Gateway_JoinProyectar">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${resultadoRevision == 'DEVOLVER'}</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_30" sourceRef="Gateway_JoinFinInstruccion" targetRef="EndEvent_Instruccion" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="Activity_AlertarCoordinador" name="Alertar al coordinador de PQR" camunda:delegateExpression="${alertarCoordinador}">
      <bpmn:documentation>Avisa a la coordinación de la Oficina de PQR que el caso consumió el 70 % del término, para redistribuir la carga antes del vencimiento.</bpmn:documentation>
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_CoordinadorAlertado" name="Coordinador alertado" camunda:asyncBefore="true">
      <bpmn:documentation>Continuación asíncrona: la rama de la alerta termina en su propio job. Así no choca con la instrucción que sigue en paralelo (OptimisticLockingException) y el engine reintenta solo si hay conflicto.</bpmn:documentation>
      <bpmn:incoming>Flow_32</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_ReconocerSilencio" name="Reconocer efectos del silencio positivo" camunda:formRef="ReconocerSilencioPositivo" camunda:formRefBinding="deployment" camunda:candidateGroups="analistas-pqr">
      <bpmn:documentation>La PQR se entiende resuelta a favor del usuario. El analista registra los efectos que se reconocen (por ejemplo, el ajuste en facturación). La decisión es favorable por ley y no se discute.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#39;sentidoDecision&#39;, &#39;FAVORABLE&#39;)}" event="end" />
        <camunda:executionListener expression="${execution.setVariable(&#39;silencioPositivo&#39;, true)}" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_JoinDecision">
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_SplitEjecucion">
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:callActivity id="CallActivity_Notificar" name="Notificar la decisión con prueba" calledElement="C7_NotificarDecision" camunda:calledElementBinding="deployment">
      <bpmn:documentation>Última actividad del perfil de C7: notificar la decisión. Proceso global reutilizable C7_NotificarDecision (Call Activity). Lo usa la primera instancia y lo vuelve a usar la decisión del recurso de reposición. Devuelve la prueba de notificación y la fecha límite para recurrir.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:in businessKey="#{execution.processBusinessKey}" />
        <camunda:in variables="all" />
        <camunda:out variables="all" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_37</bpmn:incoming>
      <bpmn:outgoing>Flow_44</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="Gateway_OrdenaAjuste" name="¿Ordena ajuste en C4?">
      <bpmn:incoming>Flow_38</bpmn:incoming>
      <bpmn:outgoing>Flow_39</bpmn:outgoing>
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Event_AjusteC4" name="Ajuste autorizado enviado a C4">
      <bpmn:documentation>Interfaz de salida C4 (ajuste autorizado). Usa el mismo mensaje MsgRefacturacionAutorizada con el que arranca la refacturación en el modelo de C4.</bpmn:documentation>
      <bpmn:incoming>Flow_39</bpmn:incoming>
      <bpmn:outgoing>Flow_41</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_AjusteC4" messageRef="Message_AjusteAutorizadoC4" camunda:delegateExpression="${enviarAjusteC4}" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Gateway_JoinAjuste">
      <bpmn:incoming>Flow_40</bpmn:incoming>
      <bpmn:incoming>Flow_41</bpmn:incoming>
      <bpmn:outgoing>Flow_42</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_SolicitaRevision" name="¿Solicita revisión en C6?">
      <bpmn:incoming>Flow_42</bpmn:incoming>
      <bpmn:outgoing>Flow_43</bpmn:outgoing>
      <bpmn:outgoing>Flow_59</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Event_RevisionC6" name="Revisión de la actuación solicitada a C6">
      <bpmn:documentation>Interfaz de salida C6 (revisión de la actuación): la PQR demostró fallas en una actuación de recuperación de consumos.</bpmn:documentation>
      <bpmn:incoming>Flow_43</bpmn:incoming>
      <bpmn:outgoing>Flow_60</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_RevisionC6" messageRef="Message_RevisionC6" camunda:delegateExpression="${solicitarRevisionC6}" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Gateway_JoinRevision">
      <bpmn:incoming>Flow_59</bpmn:incoming>
      <bpmn:incoming>Flow_60</bpmn:incoming>
      <bpmn:outgoing>Flow_45</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="Gateway_JoinEjecucion" camunda:asyncBefore="true">
      <bpmn:incoming>Flow_44</bpmn:incoming>
      <bpmn:incoming>Flow_45</bpmn:incoming>
      <bpmn:outgoing>Flow_46</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:exclusiveGateway id="Gateway_EsperaRecurso" name="¿Se espera un recurso contra la decisión?">
      <bpmn:incoming>Flow_46</bpmn:incoming>
      <bpmn:outgoing>Flow_47</bpmn:outgoing>
      <bpmn:outgoing>Flow_48</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:eventBasedGateway id="Gateway_Recurso" name="¿Llega un recurso o vence el término para recurrir?">
      <bpmn:incoming>Flow_47</bpmn:incoming>
      <bpmn:outgoing>Flow_49</bpmn:outgoing>
      <bpmn:outgoing>Flow_51</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_RecursoRecibido" name="Recurso de reposición recibido">
      <bpmn:documentation>Recurso de reposición (y, si lo pide el usuario, apelación en subsidio) presentado dentro de los cinco días hábiles siguientes a la notificación (art. 154, Ley 142). Reabre la instrucción en el mismo expediente con un nuevo radicado.</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#39;tipoPQR&#39;, &#39;RECURSO_REPOSICION&#39;)}" event="end" />
        <camunda:executionListener expression="${execution.setVariable(&#39;radicadoRecurrido&#39;, radicado)}" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_49</bpmn:incoming>
      <bpmn:outgoing>Flow_50</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Recurso" messageRef="Message_RecursoReposicion" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_PlazoRecursoVencido" name="Término para recurrir vencido: decisión en firme">
      <bpmn:incoming>Flow_51</bpmn:incoming>
      <bpmn:outgoing>Flow_52</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_PlazoRecurso">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${fechaLimiteRecursos}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_JoinCierre">
      <bpmn:incoming>Flow_48</bpmn:incoming>
      <bpmn:incoming>Flow_52</bpmn:incoming>
      <bpmn:outgoing>Flow_53</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_Apelacion" name="¿Procede remitir la apelación a la SSPD?">
      <bpmn:incoming>Flow_53</bpmn:incoming>
      <bpmn:outgoing>Flow_54</bpmn:outgoing>
      <bpmn:outgoing>Flow_56</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateThrowEvent id="Event_RemitirSSPD" name="Expediente remitido a la SSPD para la apelación">
      <bpmn:documentation>La reposición no fue favorable y el usuario interpuso la apelación en subsidio: la empresa remite el expediente completo a la SSPD (art. 154, Ley 142) y envía copia a S4 para la defensa. Responde al hallazgo de expedientes de recursos incompletos.</bpmn:documentation>
      <bpmn:incoming>Flow_54</bpmn:incoming>
      <bpmn:outgoing>Flow_55</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_RemitirSSPD" messageRef="Message_ApelacionSSPD" camunda:delegateExpression="${remitirApelacionSspd}" />
    </bpmn:intermediateThrowEvent>
    <bpmn:exclusiveGateway id="Gateway_JoinFinal">
      <bpmn:incoming>Flow_55</bpmn:incoming>
      <bpmn:incoming>Flow_56</bpmn:incoming>
      <bpmn:outgoing>Flow_57</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_CerrarExpediente" name="Cerrar o remitir el expediente" camunda:delegateExpression="${cerrarExpediente}">
      <bpmn:documentation>Última actividad del perfil: cerrar o remitir el expediente. Calcula los datos de los indicadores de §8.3: notificada dentro del término, días hábiles usados, reapertura y causa, silencio positivo y estado final del expediente.</bpmn:documentation>
      <bpmn:incoming>Flow_57</bpmn:incoming>
      <bpmn:outgoing>Flow_58</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Cierre">
        <bpmn:targetRef>DataStoreReference_ExpedientesCierre</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_PQRConcluida" name="PQR atendida y causa raíz reportada">
      <bpmn:documentation>Resultado de C7: respuesta notificada y trámite concluido o remitido. Interfaces de salida G1 y G3: la causa raíz alimenta las causas agregadas y recurrentes que exigen actualizar un control (§7.1).</bpmn:documentation>
      <bpmn:incoming>Flow_58</bpmn:incoming>
      <bpmn:messageEventDefinition id="MessageEventDefinition_CausaRaiz" messageRef="Message_CausaRaiz" camunda:delegateExpression="${reportarCausaRaiz}" />
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStoreReference_ReglasG3" name="Reglas vigentes de PQR: tipos, términos y causales (G3)" dataStoreRef="DataStore_ReglasPQR" />
    <bpmn:dataStoreReference id="DataStoreReference_Expedientes" name="Gestor de expedientes de PQR (expediente único)" dataStoreRef="DataStore_Expedientes" />
    <bpmn:dataStoreReference id="DataStoreReference_ExpedientesCierre" name="Gestor de expedientes de PQR (expediente único)" dataStoreRef="DataStore_Expedientes" />
    <bpmn:boundaryEvent id="Event_TerminoVencido" name="Término legal vencido sin decisión" attachedToRef="SubProcess_Instruir">
      <bpmn:documentation>Temporizador interrumpible: si vence el término (15 días hábiles) sin decisión aprobada, se cancela la instrucción y opera el silencio administrativo positivo (art. 158, Ley 142 de 1994).</bpmn:documentation>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_TerminoVencido">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${fechaVencimiento}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="Event_AlertaTermino" name="Término próximo a vencer (70 %)" cancelActivity="false" attachedToRef="SubProcess_Instruir">
      <bpmn:documentation>Temporizador NO interrumpible: no detiene la instrucción, solo alerta a la coordinación (control de términos; oportunidad de respuesta y capacidad ante picos, §8.3).</bpmn:documentation>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_AlertaTermino">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${fechaAlerta}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_PQRVentanilla" targetRef="Gateway_JoinCanales" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="StartEvent_PQRPortal" targetRef="Gateway_JoinCanales" />
    <bpmn:sequenceFlow id="Flow_03" sourceRef="Gateway_JoinCanales" targetRef="Gateway_JoinRecurso" />
    <bpmn:sequenceFlow id="Flow_50" sourceRef="Event_RecursoRecibido" targetRef="Gateway_JoinRecurso" />
    <bpmn:sequenceFlow id="Flow_04" sourceRef="Gateway_JoinRecurso" targetRef="Activity_RadicarPQR" />
    <bpmn:sequenceFlow id="Flow_05" sourceRef="Activity_RadicarPQR" targetRef="Gateway_JoinTipificar" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Activity_TipificarManual" targetRef="Gateway_JoinTipificar" />
    <bpmn:sequenceFlow id="Flow_06" sourceRef="Gateway_JoinTipificar" targetRef="Activity_TipificarPQR" />
    <bpmn:sequenceFlow id="Flow_07" sourceRef="Activity_TipificarPQR" targetRef="Gateway_Tipificacion" />
    <bpmn:sequenceFlow id="Flow_08" name="Sí" sourceRef="Gateway_Tipificacion" targetRef="Activity_AbrirExpediente">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${tipificacionConcluyente}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09" name="No" sourceRef="Gateway_Tipificacion" targetRef="Activity_TipificarManual">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!tipificacionConcluyente}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Activity_AbrirExpediente" targetRef="Event_ConstanciaRadicado" />
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Event_ConstanciaRadicado" targetRef="SubProcess_Instruir" />
    <bpmn:sequenceFlow id="Flow_35" sourceRef="SubProcess_Instruir" targetRef="Gateway_JoinDecision" />
    <bpmn:sequenceFlow id="Flow_31" sourceRef="Event_AlertaTermino" targetRef="Activity_AlertarCoordinador" />
    <bpmn:sequenceFlow id="Flow_32" sourceRef="Activity_AlertarCoordinador" targetRef="EndEvent_CoordinadorAlertado" />
    <bpmn:sequenceFlow id="Flow_33" sourceRef="Event_TerminoVencido" targetRef="Activity_ReconocerSilencio" />
    <bpmn:sequenceFlow id="Flow_34" sourceRef="Activity_ReconocerSilencio" targetRef="Gateway_JoinDecision" />
    <bpmn:sequenceFlow id="Flow_36" sourceRef="Gateway_JoinDecision" targetRef="Gateway_SplitEjecucion" />
    <bpmn:sequenceFlow id="Flow_37" sourceRef="Gateway_SplitEjecucion" targetRef="CallActivity_Notificar" />
    <bpmn:sequenceFlow id="Flow_38" sourceRef="Gateway_SplitEjecucion" targetRef="Gateway_OrdenaAjuste" />
    <bpmn:sequenceFlow id="Flow_44" sourceRef="CallActivity_Notificar" targetRef="Gateway_JoinEjecucion" />
    <bpmn:sequenceFlow id="Flow_39" name="Sí" sourceRef="Gateway_OrdenaAjuste" targetRef="Event_AjusteC4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable('ordenaAjusteC4') == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_40" name="No" sourceRef="Gateway_OrdenaAjuste" targetRef="Gateway_JoinAjuste">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${execution.getVariable('ordenaAjusteC4') != true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_41" sourceRef="Event_AjusteC4" targetRef="Gateway_JoinAjuste" />
    <bpmn:sequenceFlow id="Flow_42" sourceRef="Gateway_JoinAjuste" targetRef="Gateway_SolicitaRevision" />
    <bpmn:sequenceFlow id="Flow_43" name="Sí" sourceRef="Gateway_SolicitaRevision" targetRef="Event_RevisionC6">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${solicitaRevisionC6}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_59" name="No" sourceRef="Gateway_SolicitaRevision" targetRef="Gateway_JoinRevision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!solicitaRevisionC6}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_60" sourceRef="Event_RevisionC6" targetRef="Gateway_JoinRevision" />
    <bpmn:sequenceFlow id="Flow_45" sourceRef="Gateway_JoinRevision" targetRef="Gateway_JoinEjecucion" />
    <bpmn:sequenceFlow id="Flow_46" sourceRef="Gateway_JoinEjecucion" targetRef="Gateway_EsperaRecurso" />
    <bpmn:sequenceFlow id="Flow_47" name="Sí" sourceRef="Gateway_EsperaRecurso" targetRef="Gateway_Recurso">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${instancia == 'PRIMERA' &amp;&amp; procedenRecursos}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_48" name="No" sourceRef="Gateway_EsperaRecurso" targetRef="Gateway_JoinCierre">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!(instancia == 'PRIMERA' &amp;&amp; procedenRecursos)}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_49" sourceRef="Gateway_Recurso" targetRef="Event_RecursoRecibido" />
    <bpmn:sequenceFlow id="Flow_51" sourceRef="Gateway_Recurso" targetRef="Event_PlazoRecursoVencido" />
    <bpmn:sequenceFlow id="Flow_52" sourceRef="Event_PlazoRecursoVencido" targetRef="Gateway_JoinCierre" />
    <bpmn:sequenceFlow id="Flow_53" sourceRef="Gateway_JoinCierre" targetRef="Gateway_Apelacion" />
    <bpmn:sequenceFlow id="Flow_54" name="Sí" sourceRef="Gateway_Apelacion" targetRef="Event_RemitirSSPD">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${instancia == 'REPOSICION' &amp;&amp; apelacionSubsidiaria &amp;&amp; sentidoDecision != 'FAVORABLE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_56" name="No" sourceRef="Gateway_Apelacion" targetRef="Gateway_JoinFinal">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!(instancia == 'REPOSICION' &amp;&amp; apelacionSubsidiaria &amp;&amp; sentidoDecision != 'FAVORABLE')}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_55" sourceRef="Event_RemitirSSPD" targetRef="Gateway_JoinFinal" />
    <bpmn:sequenceFlow id="Flow_57" sourceRef="Gateway_JoinFinal" targetRef="Activity_CerrarExpediente" />
    <bpmn:sequenceFlow id="Flow_58" sourceRef="Activity_CerrarExpediente" targetRef="EndEvent_PQRConcluida" />
  </bpmn:process>
