<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_C7_NotificarDecision" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.39.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.20.0">
  <bpmn:collaboration id="Collaboration_C7_1">
    <bpmn:participant id="Participant_Notificacion" name="ENEL La Corocora — C7.1 · Notificar la decisión al usuario con prueba de notificación" processRef="C7_NotificarDecision">
      <bpmn:documentation>Proceso global invocado por la Call Activity de C7. Reutilizable por cualquier proceso que deba notificar una decisión al usuario (C6, C1).</bpmn:documentation>
    </bpmn:participant>
    <bpmn:participant id="Participant_UsuarioNotif" name="Usuario / suscriptor" />
    <bpmn:participant id="Participant_OperadorNotif" name="Operador de notificación con prueba de entrega (correo electrónico certificado y mensajería)" />
    <bpmn:messageFlow id="MessageFlow_Comunicacion" name="Notificación electrónica o citación" sourceRef="Event_ComunicacionEnviada" targetRef="Participant_OperadorNotif" />
    <bpmn:messageFlow id="MessageFlow_Acceso" name="Constancia de acceso al acto" sourceRef="Participant_OperadorNotif" targetRef="Event_AccesoElectronico" />
    <bpmn:messageFlow id="MessageFlow_Comparecencia" name="Comparecencia del usuario" sourceRef="Participant_UsuarioNotif" targetRef="Event_UsuarioComparecio" />
    <bpmn:messageFlow id="MessageFlow_CopiaActo" name="Copia íntegra del acto" sourceRef="Activity_NotificarPersonalmente" targetRef="Participant_UsuarioNotif" />
    <bpmn:messageFlow id="MessageFlow_Aviso" name="Aviso con copia del acto" sourceRef="Activity_NotificarAviso" targetRef="Participant_OperadorNotif" />
    <bpmn:textAnnotation id="TextAnnotation_Notificacion">
      <bpmn:text>Arts. 67 a 69 del CPACA (art. 159, Ley 142): la notificación es personal o electrónica. Si no se surte en cinco días hábiles, se hace por aviso con copia íntegra del acto. Sin prueba de notificación el caso no se cierra (§10).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Notificacion" associationDirection="None" sourceRef="TextAnnotation_Notificacion" targetRef="Activity_NotificarPersonalmente" />
    <bpmn:textAnnotation id="TextAnnotation_Recursos">
      <bpmn:text>Indica los recursos que proceden, ante quién y en qué plazo (art. 67 CPACA; art. 154, Ley 142). La regla no decide el fondo del caso.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Recursos" associationDirection="None" sourceRef="TextAnnotation_Recursos" targetRef="Activity_DeterminarRecursos" />
  </bpmn:collaboration>
  <bpmn:process id="C7_NotificarDecision" name="C7.1 · Notificar la decisión al usuario con prueba de notificación" isExecutable="true" camunda:versionTag="1.0" camunda:historyTimeToLive="180" camunda:isStartableInTasklist="false">
    <bpmn:documentation>Proceso global reutilizable. Notifica una decisión al usuario por el medio que corresponda y no termina sin prueba de notificación.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_C7_NotificarDecision">
      <bpmn:lane id="Lane_SistemaNotif" name="Sistema de notificación · gestor de expedientes">
        <bpmn:flowNodeRef>StartEvent_Notificacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_DeterminarRecursos</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_GenerarActo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_ComunicacionEnviada</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_EsperaNotificacion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_PlazoNotificacionVencido</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_NotificarAviso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AvisoEntregado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PublicarAviso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_PublicacionCumplida</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinAviso</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_AccesoElectronico</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_JoinNotificado</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_RegistrarPrueba</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Notificada</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_OrientadorNotif" name="Orientador de usuarios">
        <bpmn:flowNodeRef>Event_UsuarioComparecio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_NotificarPersonalmente</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Notificacion" name="Notificación de la decisión solicitada">
      <bpmn:outgoing>Flow_N01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="Activity_DeterminarRecursos" name="Determinar los recursos procedentes" camunda:resultVariable="resultadoRecursos" camunda:decisionRef="DeterminarRecursosProcedentes" camunda:decisionRefBinding="deployment" camunda:mapDecisionResult="singleResult">
      <bpmn:documentation>Tabla DMN DeterminarRecursosProcedentes (hit policy FIRST). El acto debe indicar los recursos que proceden, ante quién y en qué plazo (art. 67 CPACA; art. 154, Ley 142).</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:outputParameter name="procedenRecursos">${resultadoRecursos.procedenRecursos}</camunda:outputParameter>
          <camunda:outputParameter name="plazoRecursosDiasHabiles">${resultadoRecursos.plazoRecursosDiasHabiles}</camunda:outputParameter>
          <camunda:outputParameter name="textoRecursos">${resultadoRecursos.textoRecursos}</camunda:outputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_N01</bpmn:incoming>
      <bpmn:outgoing>Flow_N02</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="Activity_GenerarActo" name="Generar el acto de respuesta motivado" camunda:delegateExpression="${generarActoRespuesta}">
      <bpmn:documentation>Compone el acto con la decisión, la motivación, los recursos procedentes y sus plazos. Lo numera y lo guarda en el expediente.</bpmn:documentation>
      <bpmn:incoming>Flow_N02</bpmn:incoming>
      <bpmn:outgoing>Flow_N03</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Acto">
        <bpmn:targetRef>DataObjectReference_Acto</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataObjectReference id="DataObjectReference_Acto" name="Acto de respuesta [motivado, con recursos y plazos]" dataObjectRef="DataObject_Acto" />
    <bpmn:dataObject id="DataObject_Acto" />
    <bpmn:intermediateThrowEvent id="Event_ComunicacionEnviada" name="Notificación electrónica o citación enviada">
      <bpmn:documentation>Si el usuario autorizó la notificación electrónica, se envía el acto por correo electrónico certificado (art. 56 CPACA). Si no, se envía la citación para la notificación personal (art. 68 CPACA).</bpmn:documentation>
      <bpmn:incoming>Flow_N03</bpmn:incoming>
      <bpmn:outgoing>Flow_N04</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Comunicacion" messageRef="Message_Comunicacion" camunda:delegateExpression="${enviarComunicacion}" />
    </bpmn:intermediateThrowEvent>
    <bpmn:eventBasedGateway id="Gateway_EsperaNotificacion" name="¿Cómo se surte la notificación?">
      <bpmn:incoming>Flow_N04</bpmn:incoming>
      <bpmn:outgoing>Flow_N05</bpmn:outgoing>
      <bpmn:outgoing>Flow_N08</bpmn:outgoing>
      <bpmn:outgoing>Flow_N16</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_UsuarioComparecio" name="Usuario presentado para notificarse">
      <bpmn:documentation>El usuario (o su apoderado) se presenta en la oficina dentro de los cinco días hábiles siguientes a la citación (mensaje MsgComparecenciaNotificacion).</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#39;medioNotificacionEfectivo&#39;, &#39;PERSONAL&#39;)}" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_N05</bpmn:incoming>
      <bpmn:outgoing>Flow_N06</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Comparecencia" messageRef="Message_Comparecencia" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Activity_NotificarPersonalmente" name="Notificar personalmente la decisión" camunda:formRef="NotificarPersonalmente" camunda:formRefBinding="deployment" camunda:candidateGroups="orientadores-pqr">
      <bpmn:documentation>El orientador verifica la identidad, entrega copia íntegra del acto e informa los recursos, ante quién y en qué plazo (art. 67 CPACA).</bpmn:documentation>
      <bpmn:incoming>Flow_N06</bpmn:incoming>
      <bpmn:outgoing>Flow_N07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Event_PlazoNotificacionVencido" name="Cinco días hábiles sin notificación">
      <bpmn:incoming>Flow_N08</bpmn:incoming>
      <bpmn:outgoing>Flow_N09</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_PlazoNotificacion">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${fechaLimiteNotificacion}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Activity_NotificarAviso" name="Notificar por aviso con copia del acto" camunda:delegateExpression="${notificarPorAviso}">
      <bpmn:documentation>Notificación por aviso (art. 69 CPACA) enviada por mensajería con prueba de entrega. La notificación queda surtida al finalizar el día siguiente a la entrega.</bpmn:documentation>
      <bpmn:incoming>Flow_N09</bpmn:incoming>
      <bpmn:outgoing>Flow_N10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_AvisoEntregado" name="¿El aviso fue entregado?">
      <bpmn:incoming>Flow_N10</bpmn:incoming>
      <bpmn:outgoing>Flow_N11</bpmn:outgoing>
      <bpmn:outgoing>Flow_N12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_PublicarAviso" name="Publicar el aviso (web y cartelera)" camunda:delegateExpression="${publicarAviso}">
      <bpmn:documentation>Si se desconoce la dirección o el aviso se devuelve, se publica con copia íntegra del acto durante cinco días (art. 69, inciso 2, CPACA).</bpmn:documentation>
      <bpmn:incoming>Flow_N12</bpmn:incoming>
      <bpmn:outgoing>Flow_N13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_PublicacionCumplida" name="Publicación de cinco días cumplida">
      <bpmn:incoming>Flow_N13</bpmn:incoming>
      <bpmn:outgoing>Flow_N14</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Publicacion">
        <bpmn:timeDate xsi:type="bpmn:tFormalExpression">${fechaFinPublicacion}</bpmn:timeDate>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_JoinAviso">
      <bpmn:incoming>Flow_N11</bpmn:incoming>
      <bpmn:incoming>Flow_N14</bpmn:incoming>
      <bpmn:outgoing>Flow_N15</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_AccesoElectronico" name="Acceso electrónico al acto certificado">
      <bpmn:documentation>El operador certifica la fecha y hora en que el usuario accedió al acto (art. 56 CPACA; mensaje MsgAccesoElectronico).</bpmn:documentation>
      <bpmn:extensionElements>
        <camunda:executionListener expression="${execution.setVariable(&#39;medioNotificacionEfectivo&#39;, &#39;ELECTRONICA&#39;)}" event="end" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_N16</bpmn:incoming>
      <bpmn:outgoing>Flow_N17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_Acceso" messageRef="Message_AccesoElectronico" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_JoinNotificado">
      <bpmn:incoming>Flow_N07</bpmn:incoming>
      <bpmn:incoming>Flow_N15</bpmn:incoming>
      <bpmn:incoming>Flow_N17</bpmn:incoming>
      <bpmn:outgoing>Flow_N18</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_RegistrarPrueba" name="Registrar la prueba de notificación" camunda:delegateExpression="${registrarPruebaNotificacion}">
      <bpmn:documentation>Registra en el expediente el medio efectivo, la fecha de notificación y la prueba. Calcula si la respuesta se notificó dentro del término y la fecha límite para recurrir.</bpmn:documentation>
      <bpmn:incoming>Flow_N18</bpmn:incoming>
      <bpmn:outgoing>Flow_N19</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_Prueba">
        <bpmn:targetRef>DataStoreReference_ExpedientesNotif</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Notificada" name="Decisión notificada con prueba">
      <bpmn:incoming>Flow_N19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DataStoreReference_ExpedientesNotif" name="Gestor de expedientes de PQR" dataStoreRef="DataStore_ExpedientesNotif" />
    <bpmn:sequenceFlow id="Flow_N01" sourceRef="StartEvent_Notificacion" targetRef="Activity_DeterminarRecursos" />
    <bpmn:sequenceFlow id="Flow_N02" sourceRef="Activity_DeterminarRecursos" targetRef="Activity_GenerarActo" />
    <bpmn:sequenceFlow id="Flow_N03" sourceRef="Activity_GenerarActo" targetRef="Event_ComunicacionEnviada" />
    <bpmn:sequenceFlow id="Flow_N04" sourceRef="Event_ComunicacionEnviada" targetRef="Gateway_EsperaNotificacion" />
    <bpmn:sequenceFlow id="Flow_N05" sourceRef="Gateway_EsperaNotificacion" targetRef="Event_UsuarioComparecio" />
    <bpmn:sequenceFlow id="Flow_N08" sourceRef="Gateway_EsperaNotificacion" targetRef="Event_PlazoNotificacionVencido" />
    <bpmn:sequenceFlow id="Flow_N16" sourceRef="Gateway_EsperaNotificacion" targetRef="Event_AccesoElectronico" />
    <bpmn:sequenceFlow id="Flow_N06" sourceRef="Event_UsuarioComparecio" targetRef="Activity_NotificarPersonalmente" />
    <bpmn:sequenceFlow id="Flow_N07" sourceRef="Activity_NotificarPersonalmente" targetRef="Gateway_JoinNotificado" />
    <bpmn:sequenceFlow id="Flow_N09" sourceRef="Event_PlazoNotificacionVencido" targetRef="Activity_NotificarAviso" />
    <bpmn:sequenceFlow id="Flow_N10" sourceRef="Activity_NotificarAviso" targetRef="Gateway_AvisoEntregado" />
    <bpmn:sequenceFlow id="Flow_N11" name="Sí" sourceRef="Gateway_AvisoEntregado" targetRef="Gateway_JoinAviso">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${estadoAviso == 'ENTREGADO'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_N12" name="No: devuelto" sourceRef="Gateway_AvisoEntregado" targetRef="Activity_PublicarAviso">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${estadoAviso == 'DEVUELTO'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_N13" sourceRef="Activity_PublicarAviso" targetRef="Event_PublicacionCumplida" />
    <bpmn:sequenceFlow id="Flow_N14" sourceRef="Event_PublicacionCumplida" targetRef="Gateway_JoinAviso" />
    <bpmn:sequenceFlow id="Flow_N15" sourceRef="Gateway_JoinAviso" targetRef="Gateway_JoinNotificado" />
    <bpmn:sequenceFlow id="Flow_N17" sourceRef="Event_AccesoElectronico" targetRef="Gateway_JoinNotificado" />
    <bpmn:sequenceFlow id="Flow_N18" sourceRef="Gateway_JoinNotificado" targetRef="Activity_RegistrarPrueba" />
    <bpmn:sequenceFlow id="Flow_N19" sourceRef="Activity_RegistrarPrueba" targetRef="EndEvent_Notificada" />
  </bpmn:process>
  <bpmn:message id="Message_Comunicacion" name="MsgComunicacionDecision" />
  <bpmn:message id="Message_Comparecencia" name="MsgComparecenciaNotificacion" />
  <bpmn:message id="Message_AccesoElectronico" name="MsgAccesoElectronico" />
  <bpmn:dataStore id="DataStore_ExpedientesNotif" name="Gestor de expedientes de PQR" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_Collaboration_C7_1">
    <bpmndi:BPMNPlane id="BPMNPlane_Collaboration_C7_1" bpmnElement="Collaboration_C7_1">
      <bpmndi:BPMNShape id="Participant_Notificacion_di" bpmnElement="Participant_Notificacion" isHorizontal="true">
        <dc:Bounds x="160" y="180" width="1740" height="600" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_SistemaNotif_di" bpmnElement="Lane_SistemaNotif" isHorizontal="true">
        <dc:Bounds x="190" y="340" width="1710" height="440" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_OrientadorNotif_di" bpmnElement="Lane_OrientadorNotif" isHorizontal="true">
        <dc:Bounds x="190" y="180" width="1710" height="160" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Notificacion_di" bpmnElement="StartEvent_Notificacion">
        <dc:Bounds x="262" y="442" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="235" y="483" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_DeterminarRecursos_di" bpmnElement="Activity_DeterminarRecursos">
        <dc:Bounds x="350" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_GenerarActo_di" bpmnElement="Activity_GenerarActo">
        <dc:Bounds x="500" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataObjectReference_Acto_di" bpmnElement="DataObjectReference_Acto">
        <dc:Bounds x="532" y="575" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="506" y="630" width="89" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_ComunicacionEnviada_di" bpmnElement="Event_ComunicacionEnviada">
        <dc:Bounds x="662" y="442" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="641" y="394" width="79" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_EsperaNotificacion_di" bpmnElement="Gateway_EsperaNotificacion">
        <dc:Bounds x="755" y="435" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="790" y="405" width="90" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_UsuarioComparecio_di" bpmnElement="Event_UsuarioComparecio">
        <dc:Bounds x="862" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="840" y="283" width="81" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_NotificarPersonalmente_di" bpmnElement="Activity_NotificarPersonalmente">
        <dc:Bounds x="960" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_PlazoNotificacionVencido_di" bpmnElement="Event_PlazoNotificacionVencido">
        <dc:Bounds x="862" y="442" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="852" y="483" width="56" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_NotificarAviso_di" bpmnElement="Activity_NotificarAviso">
        <dc:Bounds x="960" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_AvisoEntregado_di" bpmnElement="Gateway_AvisoEntregado" isMarkerVisible="true">
        <dc:Bounds x="1125" y="435" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1118" y="401" width="64" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_PublicarAviso_di" bpmnElement="Activity_PublicarAviso">
        <dc:Bounds x="1200" y="530" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_PublicacionCumplida_di" bpmnElement="Event_PublicacionCumplida">
        <dc:Bounds x="1342" y="552" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1324" y="593" width="72" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_JoinAviso_di" bpmnElement="Gateway_JoinAviso" isMarkerVisible="true">
        <dc:Bounds x="1415" y="435" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_AccesoElectronico_di" bpmnElement="Event_AccesoElectronico">
        <dc:Bounds x="862" y="682" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="836" y="634" width="89" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_JoinNotificado_di" bpmnElement="Gateway_JoinNotificado" isMarkerVisible="true">
        <dc:Bounds x="1535" y="435" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_RegistrarPrueba_di" bpmnElement="Activity_RegistrarPrueba">
        <dc:Bounds x="1630" y="420" width="100" height="80" />
      </bpmndi:BPMNShape>
