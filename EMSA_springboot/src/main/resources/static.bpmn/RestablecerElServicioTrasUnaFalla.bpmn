    </bpmn:startEvent>
    <bpmn:userTask id="Activity_15cunsj" name="Restablecer suministro" camunda:formRef="reporteReparacion" camunda:formRefBinding="latest" camunda:candidateGroups="cuadrilla">
      <bpmn:incoming>Flow_0063tgp</bpmn:incoming>
