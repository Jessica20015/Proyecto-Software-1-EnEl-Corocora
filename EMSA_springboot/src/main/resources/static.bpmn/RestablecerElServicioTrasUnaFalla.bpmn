    <bpmn:endEvent id="DemoraEscalada" name="Demora escalada">
      <bpmn:incoming>Flow_DemoraFin</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="EscalarDemora" name="Escalar demora en restablecimiento" camunda:formRef="escalarDemoraForm" camunda:formRefBinding="latest" camunda:candidateGroups="coordinador-zona">
