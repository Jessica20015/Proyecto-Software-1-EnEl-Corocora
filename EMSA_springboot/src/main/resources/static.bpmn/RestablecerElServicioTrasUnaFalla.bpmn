    <bpmn:sequenceFlow id="Flow_1y03nmv" sourceRef="ClasificarDano" targetRef="Gateway_05ati0f" />
    <bpmn:sequenceFlow id="Flow_0fe5z8k" sourceRef="Activity_1sawny7" targetRef="ClasificarDano" />
    <bpmn:sequenceFlow id="Flow_VisitaNo" name="No" sourceRef="Gateway_VisitaRealizada" targetRef="Event_VisitaNoRealizada" />
    <bpmn:sequenceFlow id="Flow_VisitaSi" name="Si" sourceRef="Gateway_VisitaRealizada" targetRef="Activity_1sawny7">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${visita == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_0ts0326" sourceRef="realizarVisitaTecnica" targetRef="Gateway_VisitaRealizada" />
    <bpmn:boundaryEvent id="Event_DemoraRestablecimiento" name="Demora en restablecimiento" cancelActivity="false" attachedToRef="Activity_15cunsj">
      <bpmn:outgoing>Flow_DemoraEscalar</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Demora">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT2M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
