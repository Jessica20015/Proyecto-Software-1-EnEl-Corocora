    <bpmn:sequenceFlow id="Flow_1ko6y85" name="Si" sourceRef="Gateway_05ati0f" targetRef="SolicitarEquipos">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requiereMateriales == true}</bpmn:conditionExpression>
