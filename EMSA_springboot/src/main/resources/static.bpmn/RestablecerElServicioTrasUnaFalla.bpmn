      <bpmn:outgoing>Flow_06bnoxw</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:callActivity id="realizarVisitaTecnica" name="Realizar Visita Técnica" calledElement="realizarVisitaTecnica">
      <bpmn:extensionElements>
        <camunda:in source="nombre" target="nombre" />
        <camunda:in source="domicilio" target="domicilio" />
        <camunda:in source="falla" target="falla" />
        <camunda:out source="visita" target="visita" />
        <camunda:out source="valorTotal" target="valorTotal" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_035hez0</bpmn:incoming>
      <bpmn:outgoing>Flow_0ts0326</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:startEvent id="StartEventRegistroFalla" name="Aviso de interrupción recibido" camunda:formRef="registroFallaRecibido" camunda:formRefBinding="latest">
