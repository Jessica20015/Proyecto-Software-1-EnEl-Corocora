  <bpmn:collaboration id="Collaboration_1jp4qmj">
    <bpmn:participant id="Participant_18zv2w5" name="Cuadrilla" processRef="realizarVisitaTecnica" />
  </bpmn:collaboration>
  <bpmn:process id="realizarVisitaTecnica" name="Realizar visita técnica" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="StartEvent_1" name="se visita el domicilio">
      <bpmn:outgoing>Flow_1jzxv7g</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="ValidarVisita" name="Validar visita" camunda:formRef="validarVisitaForm" camunda:formRefBinding="latest">
      <bpmn:incoming>Flow_1jzxv7g</bpmn:incoming>
      <bpmn:outgoing>Flow_0llh0m3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_0ghdx83" name="¿Se realizo la visita?" default="visitaNoRealizada">
      <bpmn:incoming>Flow_0llh0m3</bpmn:incoming>
      <bpmn:outgoing>visitaRealizada</bpmn:outgoing>
      <bpmn:outgoing>visitaNoRealizada</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="realizarReporteVisita" name="Realizar reporte de visita tecnica" camunda:formRef="realizarReporteVisitaTecnica" camunda:formRefBinding="latest">
      <bpmn:incoming>visitaRealizada</bpmn:incoming>
      <bpmn:outgoing>Flow_1p39o9e</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Event_0iml9af" name="Reporte de visita creado">
      <bpmn:incoming>Flow_1p39o9e</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1jzxv7g" sourceRef="StartEvent_1" targetRef="ValidarVisita" />
    <bpmn:sequenceFlow id="Flow_0llh0m3" sourceRef="ValidarVisita" targetRef="Gateway_0ghdx83" />
    <bpmn:sequenceFlow id="visitaRealizada" name="Si" sourceRef="Gateway_0ghdx83" targetRef="realizarReporteVisita">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${visita==true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="visitaNoRealizada" name="No" sourceRef="Gateway_0ghdx83" targetRef="Event_1eeg5y2" />
    <bpmn:sequenceFlow id="Flow_1p39o9e" sourceRef="realizarReporteVisita" targetRef="Event_0iml9af" />
    <bpmn:endEvent id="Event_1eeg5y2" name="Queja no tomada">
      <bpmn:incoming>visitaNoRealizada</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_177z1w8" />
    </bpmn:endEvent>
  </bpmn:process>
