          <text>nivelDano</text>
        </inputExpression>
      </input>
      <output id="Output_1" label="Requiere materiales adicionales" name="requiereMateriales" typeRef="boolean" />
      <rule id="DecisionRule_Leve">
        <inputEntry id="UnaryTests_Leve">
          <text>"Leve"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_Leve">
          <text>false</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_Moderado">
