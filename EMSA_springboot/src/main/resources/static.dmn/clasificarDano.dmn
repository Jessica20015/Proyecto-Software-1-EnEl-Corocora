          <text>"Moderado"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_Moderado">
          <text>true</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_Severo">
        <inputEntry id="UnaryTests_Severo">
          <text>"Severo"</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_Severo">
          <text>true</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
