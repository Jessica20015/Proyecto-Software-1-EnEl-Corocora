  <decision id="clasificacionRepuestos" name="Clasificación de repuestos" camunda:historyTimeToLive="30">
    <decisionTable id="DecisionTable_0zqboxx" hitPolicy="UNIQUE">
      <input id="Input_1" label="Nivel de daño">
